# Chaan-Been — Ubuntu VM deploy env
# Copy to `.env` beside docker-compose.yml and fill in before `docker compose up -d --build`.
# See webapp/api/.env.example for the full option list.

# REQUIRED: first-boot admin password (empty = random one written to webapp/data/.first_run_password)
SCC_ADMIN_PASSWORD=change-me-to-something-long

# REQUIRED in production (SCC_ENV=production refuses to boot without it)
SCC_ENV=production
SCC_API_KEY_PEPPER=generate-with-openssl-rand-hex-32

# Your public URL (Cloudflare Tunnel hostname). Used for CORS.
SCC_CORS_ORIGINS=https://chaanbeen.yourdomain.com

# Optional: persist JWTs across redeploys (else auto-generated into the scc-data volume)
SCC_SECRET_KEY=

# Optional: only needed with docker-compose.tunnel.yml --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=
