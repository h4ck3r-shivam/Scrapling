WORKDIR /app/webapp/web
# Gracefully handle missing web/ (pre-scaffold) – create placeholder dist
COPY webapp/web/package.json webapp/web/package-lock.json* ./
COPY webapp/web/ ./
RUN if [ -f package.json ]; then \
      npm ci 2>/dev/null || npm install 2>/dev/null; \
      npm run build 2>/dev/null || (mkdir -p dist && echo '<!doctype html><html><body>Scrapling</body></html>' > dist/index.html); \
    else \
      mkdir -p dist && echo '<!doctype html><html><body>Scrapling placeholder</body></html>' > dist/index.html; \
    fi

