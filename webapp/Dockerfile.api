# syntax=docker/dockerfile:1.6
# Chaan-Been – FastAPI (Ubuntu VM + Cloudflare Tunnel)
# Context: repo root (docker-compose.yml: build.context = .)
# Serves API + SPA (web/dist via StaticFiles).

# ---------- Stage 1: build frontend (Vite) ----------
FROM node:20.18-slim AS webbuild
WORKDIR /app/webapp/web
COPY webapp/web/package.json webapp/web/package-lock.json* ./
COPY webapp/web/ ./
RUN npm ci && npm run build

# ---------- Stage 2: Python API ----------
FROM python:3.12.7-slim-bookworm

LABEL io.modelcontextprotocol.server.name="io.github.D4Vinci/Scrapling"

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/home/appuser

WORKDIR /app

# tini (PID 1 reaping) + curl (HEALTHCHECK); create non-root appuser with fixed uid 1000
RUN apt-get update && apt-get install -y --no-install-recommends curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 -d /home/appuser -s /bin/bash appuser \
    && mkdir -p /ms-playwright /app/webapp/data /home/appuser \
    && chown -R appuser:appuser /ms-playwright /home/appuser /app

# Layer cache: manifests first (uv.lock committed — reproducible --frozen build)
COPY pyproject.toml uv.lock ./
COPY webapp/pyproject.toml ./webapp/pyproject.toml

# Install deps with ALL extras (scrapling[all] includes webapp: fastapi, uvicorn, aiosqlite, etc).
# --frozen = reproducible build, fails fast if uv.lock is stale (run `uv lock` and commit uv.lock).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-extras --compile-bytecode

# Copy source tree
COPY . .

# Copy built SPA into api image (served by FastAPI StaticFiles at /)
COPY --from=webbuild /app/webapp/web/dist ./webapp/web/dist

# Install Playwright chromium (+ system deps) into PLAYWRIGHT_BROWSERS_PATH and re-sync project
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && \
    uv run playwright install --with-deps chromium && \
    uv sync --frozen --all-extras --compile-bytecode && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Persisted runtime dirs (app.db, exports, crawls, .jwt_secret, elements_storage.db)
RUN mkdir -p /app/webapp/data && chown -R appuser:appuser /app/webapp /ms-playwright

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD curl -f http://localhost:8000/api/health || exit 1

USER appuser
VOLUME /app/webapp/data
EXPOSE 8000

ENTRYPOINT ["tini", "--"]

# --proxy-headers required behind Cloudflare Tunnel.
# Workers/concurrency tuned for the compose 2CPU/3G limits; graceful shutdown 30s for in-flight crawls.
CMD ["uv","run","uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--app-dir","webapp/api","--proxy-headers","--workers","2","--limit-concurrency","100","--timeout-graceful-shutdown","30"]
