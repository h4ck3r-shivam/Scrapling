# Scrapling Control Center — environment configuration
# Copy this file to `.env` and edit for your deployment.

# --- Admin bootstrap ---
# On the very first boot the server creates an admin user. If SCC_ADMIN_PASSWORD is
# set, that password is used. If empty, a random 24-char password is generated,
# written to webapp/data/.first_run_password (mode 0600), and exposed via
# GET /api/auth/first-run-hint so the login screen can show it once.
SCC_ADMIN_EMAIL=admin@example.com
SCC_ADMIN_PASSWORD=

# --- Persistence ---
# All paths are under webapp/data/ by default.
SCC_DB_PATH=
SCC_DATA_DIR=
SCC_ADAPTIVE_DB_PATH=

# --- Security ---
# Leave SCC_SECRET_KEY empty to auto-generate one persisted to
# webapp/data/.jwt_secret (mode 0600). Set explicitly for multi-instance deploys.
SCC_SECRET_KEY=
# P0 hardening: short-lived JWTs — 15m access + 7d refresh (both with jti).
# Was 1440 (24h) single-token. Override only to shorten, never to lengthen
# beyond 60m without a documented risk acceptance.
SCC_ACCESS_TOKEN_TTL_MINUTES=15
SCC_REFRESH_TOKEN_TTL_DAYS=7
# Deployment env: set SCC_ENV=production in prod. Production boot FAILS unless
# SCC_API_KEY_PEPPER is set (see security.require_pepper_in_prod).
SCC_ENV=dev
# Pepper mixed into API-key hash: sha256(pepper + raw). Empty = sha256(raw) (back-compat, dev only).
# REQUIRED in production (SCC_ENV=production). Set a long random string
# (e.g. `openssl rand -hex 32`) for new deployments; rotation
# requires re-issuing existing API keys.
SCC_API_KEY_PEPPER=
# Redis for cross-replica WebSocket fan-out. If unset, WS hub is in-memory (single-replica).
# Example: redis://localhost:6379/0  or  redis://:password@host:6379/0
SCC_REDIS_URL=

# --- CORS ---
# Comma-separated list of allowed origins. The default only covers the Vite dev server.
# In production set this to your actual FQDN, e.g.:
# SCC_CORS_ORIGINS=https://scrapling.yourdomain.com,https://api.yourdomain.com
SCC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Execution ---
SCC_MAX_CONCURRENT_JOBS=3
SCC_DEFAULT_FETCH_TIMEOUT=60
# Comma-separated allow-list of hostnames the /fetch endpoint will accept.
# Empty (default) means no restriction. Example:
# SCC_OUTBOUND_DOMAIN_ALLOWLIST=example.com,api.trusted.com
SCC_OUTBOUND_DOMAIN_ALLOWLIST=

# --- MCP server ---
# The MCP server is an HTTP-wrapped subprocess you can launch from /system/mcp/start.
# Set SCC_MCP_ENABLED=true to allow it.
SCC_MCP_ENABLED=false
SCC_MCP_PORT=8017

# --- Cloudflare Tunnel (optional sidecar) ---
# If using the cloudflared sidecar in docker-compose.yml, set:
# CLOUDFLARE_TUNNEL_TOKEN=...